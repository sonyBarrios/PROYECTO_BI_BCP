-- CREACION DE LAS TABLAS PARA LA CAPA RAW (transaccionales)--------- 

CREATE SCHEMA IF NOT EXISTS tr_raw_bcp; 

 

-- Tabla de Clientes 

CREATE TABLE tr_raw_bcp.cliente ( 

    cliente_id VARCHAR(20) PRIMARY KEY, 

    nombre_completo VARCHAR(100) NOT NULL, 

    documento_identidad VARCHAR(20) UNIQUE NOT NULL, 

    email VARCHAR(100), 

    telefono VARCHAR(50), 

    fecha_nacimiento DATE 

); 

 

-- Tabla de Cuentas 

CREATE TABLE tr_raw_bcp.cuenta ( 

    cuenta_id VARCHAR(20) PRIMARY KEY, 

    cliente_id VARCHAR(20) NOT NULL, 

    tipo_cuenta VARCHAR(20) NOT NULL, 

    fecha_creacion DATE NOT NULL, 

    estado_cuenta VARCHAR(20) NOT NULL, 

    saldo_total DECIMAL(18,2), 

    CONSTRAINT fk_cliente 

        FOREIGN KEY (cliente_id) REFERENCES tr_raw_bcp.cliente(cliente_id) 

        ON DELETE CASCADE 

); 

 

-- Tabla de Dispositivos 

CREATE TABLE tr_raw_bcp.dispositivo ( 

    dispositivo_id VARCHAR(20) PRIMARY KEY, 

    tipo_dispositivo VARCHAR(50) NOT NULL, 

    sistema_operativo VARCHAR(50), 

    version_so VARCHAR(20) 

); 

 

-- Tabla de Ubicaciones 

CREATE TABLE tr_raw_bcp.ubicacion ( 

    ubicacion_id VARCHAR(20) PRIMARY KEY, 

    pais VARCHAR(50), 

    ciudad VARCHAR(50), 

    coordenadas VARCHAR(100) 

); 

 

-- Tabla de Transacciones 

CREATE TABLE tr_raw_bcp.transaccion ( 

    transaccion_id VARCHAR(20) PRIMARY KEY, 

    cuenta_id VARCHAR(20) NOT NULL, 

    dispositivo_id VARCHAR(20) NOT NULL, 

    ubicacion_id VARCHAR(20) NOT NULL, 

    tipo_transaccion VARCHAR(50) NOT NULL, 

    monto DECIMAL(18,2) NOT NULL, 

    fecha TIMESTAMP NOT NULL, 

    estado VARCHAR(20) NOT NULL, 

    CONSTRAINT fk_cuenta 

        FOREIGN KEY (cuenta_id) REFERENCES tr_raw_bcp.cuenta(cuenta_id) 

        ON DELETE CASCADE, 

    CONSTRAINT fk_dispositivo 

        FOREIGN KEY (dispositivo_id) REFERENCES tr_raw_bcp.dispositivo(dispositivo_id), 

    CONSTRAINT fk_ubicacion 

        FOREIGN KEY (ubicacion_id) REFERENCES tr_raw_bcp.ubicacion(ubicacion_id) 

); 

 

-- Tabla de Alertas de Fraude 

CREATE TABLE tr_raw_bcp.alerta_fraude ( 

    alerta_id VARCHAR(20) PRIMARY KEY, 

    transaccion_id VARCHAR(20) NOT NULL, 

    riesgo VARCHAR(20), 

    descripcion VARCHAR(255), 

    detectado_ai BOOLEAN DEFAULT FALSE, 

    fecha_deteccion TIMESTAMP NOT NULL, 

    CONSTRAINT fk_transaccion 

        FOREIGN KEY (transaccion_id) REFERENCES tr_raw_bcp.transaccion(transaccion_id) 

        ON DELETE CASCADE 

); 

 

