-- Tabla de Hechos: Transacciones 

CREATE TABLE dim_master_bcp.fact_transaccion ( 

    transaccion_sk BIGSERIAL PRIMARY KEY, 

    cliente_sk INT REFERENCES dim_master_bcp.dim_cliente(cliente_sk), 

    producto_sk INT REFERENCES dim_master_bcp.dim_producto(producto_sk), 

    tiempo_sk INT REFERENCES dim_master_bcp.dim_tiempo(tiempo_sk), 

    canal_sk INT REFERENCES dim_master_bcp.dim_canal(canal_sk), 

    dispositivo_sk INT REFERENCES dim_master_bcp.dim_dispositivo(dispositivo_sk), 

    ubicacion_sk INT REFERENCES dim_master_bcp.dim_ubicacion(ubicacion_sk), 

    alerta_sk INT REFERENCES dim_master_bcp.dim_alerta(alerta_sk), 

    monto NUMERIC(12,2) NOT NULL, 

    tipo_transaccion VARCHAR(50), 

    estado VARCHAR(20), 

    moneda VARCHAR(10), 

    tx_irregular BOOLEAN DEFAULT FALSE 

); 

 

 

INSERT INTO dim_master_bcp.fact_transaccion ( 

    cliente_sk, producto_sk, tiempo_sk, canal_sk, dispositivo_sk, ubicacion_sk, alerta_sk, 

    monto, tipo_transaccion, estado, moneda, tx_irregular 

) 

SELECT 

    c.cliente_sk, 

    p.producto_sk, 

    t_dim.tiempo_sk, 

    NULL AS canal_sk, 

    d.dispositivo_sk, 

    u.ubicacion_sk, 

    a.alerta_sk, 

    s.monto, 

    s.tipo_transaccion, 

    s.estado, 

    s.moneda, 

    CASE WHEN a.alerta_sk IS NOT NULL THEN TRUE ELSE FALSE END AS tx_irregular 

FROM stg_bcp.stg_transaccion s 

JOIN dim_master_bcp.dim_cliente c   ON c.cliente_id = s.cliente_id 

JOIN dim_master_bcp.dim_producto p  ON p.nombre_producto = (SELECT nombre_producto FROM stg_bcp.stg_cuenta c2 WHERE c2.cuenta_id = s.cuenta_id LIMIT 1) 

JOIN dim_master_bcp.dim_tiempo t_dim ON t_dim.fecha = DATE(s.fecha) 

LEFT JOIN dim_master_bcp.dim_dispositivo d ON d.dispositivo_id = s.dispositivo_id 

LEFT JOIN dim_master_bcp.dim_ubicacion u   ON u.ubicacion_id = s.ubicacion_id 

LEFT JOIN dim_master_bcp.dim_alerta a      ON a.transaccion_id = s.transaccion_id; 

 

 

 

