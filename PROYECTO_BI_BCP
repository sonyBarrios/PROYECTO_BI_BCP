Cargar la Tabla Dimensional con el Método ETL 

-- Llenado del Esquema Stagging 

 

INSERT INTO stg_bcp.stg_cliente ( 

    cliente_id, dni, nombres, apellidos, 

    total_transacciones, monto_total, ultima_transaccion, 

    riesgo_cliente, desercion, segmento, fuente, fecha_carga 

) 

SELECT 

    c.cliente_id, 

    c.documento_identidad AS dni, 

    SPLIT_PART(c.nombre_completo, ' ', 1) AS nombres, 

    SUBSTRING(c.nombre_completo FROM POSITION(' ' IN c.nombre_completo)+1) AS apellidos, 

    COUNT(t.transaccion_id) AS total_transacciones, 

    COALESCE(SUM(t.monto),0) AS monto_total, 

    MAX(t.fecha) AS ultima_transaccion, 

    CASE 

        WHEN COALESCE(SUM(t.monto),0) > 50000 THEN 'ALTO' 

        WHEN COALESCE(SUM(t.monto),0) > 10000 THEN 'MEDIO' 

        ELSE 'BAJO' 

    END AS riesgo_cliente, 

    CASE 

        WHEN MAX(t.fecha) < NOW() - INTERVAL '90 days' THEN TRUE ELSE FALSE 

    END AS desercion, 

    CASE 

        WHEN COALESCE(SUM(t.monto),0) > 50000 THEN 'Premium' 

        WHEN COALESCE(SUM(t.monto),0) > 10000 THEN 'Estandar' 

        ELSE 'Basico' 

    END AS segmento, 

    'RAW' AS fuente, 

    NOW() AS fecha_carga 

FROM tr_raw_bcp.cliente c 

LEFT JOIN tr_raw_bcp.cuenta cu ON cu.cliente_id = c.cliente_id 

LEFT JOIN tr_raw_bcp.transaccion t ON t.cuenta_id = cu.cuenta_id 

GROUP BY c.cliente_id, c.documento_identidad, c.nombre_completo; 

 

 

 

INSERT INTO stg_bcp.stg_cuenta ( 

    cuenta_id, cliente_id, tipo_cuenta, nombre_producto, categoria, fuente, fecha_carga 

) 

SELECT 

    cu.cuenta_id, 

    cu.cliente_id, 

    cu.tipo_cuenta, 

    cu.tipo_cuenta AS nombre_producto, 

    CASE 

        WHEN cu.tipo_cuenta ILIKE '%ahorro%' THEN 'Ahorro' 

        WHEN cu.tipo_cuenta ILIKE '%corriente%' THEN 'Corriente' 

        ELSE 'Otro' 

    END AS categoria, 

    'RAW' AS fuente, 

    NOW() AS fecha_carga 

FROM tr_raw_bcp.cuenta cu; 

 

INSERT INTO stg_bcp.stg_dispositivo ( 

    dispositivo_id, tipo_dispositivo, sistema_operativo, version_so, fuente, fecha_carga 

) 

SELECT 

    d.dispositivo_id, 

    d.tipo_dispositivo, 

    d.sistema_operativo, 

    d.version_so, 

    'RAW', 

    NOW() 

FROM tr_raw_bcp.dispositivo d; 

 

INSERT INTO stg_bcp.stg_ubicacion ( 

    ubicacion_id, pais, ciudad, coordenadas, fuente, fecha_carga 

) 

SELECT 

    u.ubicacion_id, 

    u.pais, 

    u.ciudad, 

    u.coordenadas, 

    'RAW', 

    NOW() 

FROM tr_raw_bcp.ubicacion u; 

 

INSERT INTO stg_bcp.stg_transaccion ( 

    transaccion_id, cuenta_id, cliente_id, dispositivo_id, ubicacion_id, 

    tipo_transaccion, monto, fecha, estado, moneda, fuente, fecha_carga 

) 

SELECT 

    t.transaccion_id, 

    t.cuenta_id, 

    cu.cliente_id, 

    t.dispositivo_id, 

    t.ubicacion_id, 

    t.tipo_transaccion, 

    t.monto, 

    t.fecha, 

    t.estado, 

    'PEN' AS moneda, 

    'RAW', 

    NOW() 

FROM tr_raw_bcp.transaccion t 

JOIN tr_raw_bcp.cuenta cu ON cu.cuenta_id = t.cuenta_id; 

 

INSERT INTO stg_bcp.stg_alerta ( 

    alerta_id, transaccion_id, tipo_riesgo, descripcion, detectado_ai, 

    fecha_deteccion, fuente, fecha_carga 

) 

SELECT 

    a.alerta_id, 

    a.transaccion_id, 

    a.riesgo AS tipo_riesgo, 

    a.descripcion, 

    a.detectado_ai, 

    a.fecha_deteccion, 

    'RAW', 

    NOW() 

FROM tr_raw_bcp.alerta_fraude a; 

 

 

-- ================================ 

-- DIM_CLIENTE 

-- ================================ 

INSERT INTO dim_master_bcp.dim_cliente ( 

    cliente_id, nombres, apellidos, segmento, riesgo_cliente, 

    desercion, prob_desercion, clv, cliente_valor, prob_riesgo, ultima_actualizacion 

) 

SELECT DISTINCT 

    s.cliente_id, 

    s.nombres, 

    s.apellidos, 

    s.segmento, 

    s.riesgo_cliente, 

    s.desercion, 

    ROUND(RANDOM()::NUMERIC, 2) AS prob_desercion, 

    (s.monto_total * 0.05)::NUMERIC AS clv, 

    CASE 

        WHEN s.monto_total > 50000 THEN 'ALTO' 

        WHEN s.monto_total > 10000 THEN 'MEDIO' 

        ELSE 'BAJO' 

    END AS cliente_valor, 

    ROUND(RANDOM()::NUMERIC, 2) AS prob_riesgo, 

    NOW() 

FROM stg_bcp.stg_cliente s 

ON CONFLICT (cliente_id) DO UPDATE 

SET nombres = EXCLUDED.nombres, 

    apellidos = EXCLUDED.apellidos, 

    segmento = EXCLUDED.segmento, 

    riesgo_cliente = EXCLUDED.riesgo_cliente, 

    desercion = EXCLUDED.desercion, 

    clv = EXCLUDED.clv, 

    cliente_valor = EXCLUDED.cliente_valor, 

    prob_riesgo = EXCLUDED.prob_riesgo, 

    ultima_actualizacion = NOW(); 

 

